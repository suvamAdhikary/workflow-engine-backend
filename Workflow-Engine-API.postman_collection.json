                  "pm.test('Workflow skipped due to filter', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.status).to.equal('skipped');",
                  "});",
                  "",
                  "console.log('✅ Workflow correctly skipped due to filter conditions');"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"user.login\",\n  \"user\": {\n    \"id\": \"user_67890\",\n    \"name\": \"Jane Smith\",\n    \"email\": \"jane.smith@example.com\",\n    \"verified\": true\n  },\n  \"timestamp\": \"{{timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/t/{{triggerPath}}",
              "host": ["{{baseUrl}}"],
              "path": ["t", "{{triggerPath}}"]
            },
            "description": "Test workflow filtering - should be skipped\n\n**Why Skipped:**\n- event_type is 'user.login' (not 'user.signup')\n- Filter condition fails, workflow execution stops\n\n**Expected Result:** status = 'skipped'"
          }
        },
        {
          "name": "Trigger with Large Payload (Should Fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Large payload rejected', function () {",
                  "    pm.expect(pm.response.code).to.equal(400);",
                  "});",
                  "",
                  "console.log('✅ Large payload correctly rejected by input sanitization');"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"user.signup\",\n  \"user\": {\n    \"name\": \"Test User\",\n    \"email\": \"test@example.com\"\n  },\n  \"large_data\": \"{{$randomLoremParagraphs}}\".repeat(1000),\n  \"test_purpose\": \"payload_size_validation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/t/{{triggerPath}}",
              "host": ["{{baseUrl}}"],
              "path": ["t", "{{triggerPath}}"]
            },
            "description": "Test payload size limits (should be rejected)\n\n**Security Test:**\n- Tests 1MB payload size limit\n- Validates input sanitization\n- Expected: 400 Bad Request"
          }
        }
      ],
      "description": "Webhook trigger testing including success, filter, and security scenarios"
    },
    {
      "name": "📊 Run History",
      "item": [
        {
          "name": "List All Runs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Runs retrieved successfully', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
